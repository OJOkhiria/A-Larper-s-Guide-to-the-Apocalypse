[sub_resource type="Resource" id="Resource_jvm1p"]
script = ExtResource("19_jcwqk")
speaker_img = ExtResource("20_lcl7h")
text = "Sometimes, instead of taking to straightforward, cool-looking path that people tell you about, you need to find your own path."
