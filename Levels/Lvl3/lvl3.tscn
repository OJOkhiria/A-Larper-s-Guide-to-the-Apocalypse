[sub_resource type="Resource" id="Resource_h6diq"]
script = ExtResource("18_4f84q")
speaker_img = ExtResource("19_xnj3f")
text = "You kids need to learn to stop biting off more than you can chew."
text_speed = 14.0
text_sound = ExtResource("20_f3u4g")
metadata/_custom_type_script = "uid://q2hfxekwglu3"

[sub_resource type="Resource" id="Resource_jvm1p"]
script = ExtResource("18_4f84q")
speaker_img = ExtResource("19_xnj3f")
text = "Sometimes, instead of taking to straightforward, cool-looking path that people tell you about, you need to find your own path."
text_speed = 14.0
text_sound = ExtResource("20_f3u4g")
metadata/_custom_type_script = "uid://q2hfxekwglu3"

[sub_resource type="Resource" id="Resource_gfug0"]
script = ExtResource("18_4f84q")
speaker_img = ExtResource("21_esiih")
text = "Come on! You got this."
text_speed = 14.0
text_sound = ExtResource("20_f3u4g")
