[sub_resource type="Resource" id="Resource_visqm"]
script = ExtResource("18_4f84q")
speaker_img = ExtResource("21_esiih")
text = "Don't hesitate. Take a leap of faith."
text_speed = 14.0
text_sound = ExtResource("20_f3u4g")
