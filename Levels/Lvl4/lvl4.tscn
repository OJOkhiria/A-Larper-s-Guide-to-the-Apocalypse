[sub_resource type="Resource" id="Resource_cp3wb"]
script = ExtResource("7_dialogue_text")
speaker_img = ExtResource("8_real")
text = "Fix the electrical panels before we try to exit, or else we'll be more fried than CS majors after graduation."
